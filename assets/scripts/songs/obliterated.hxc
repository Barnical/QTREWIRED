import flixel.FlxG;
import flixel.FlxSprite;
import flixel.tweens.FlxTween;
import flixel.tweens.FlxEase;
import flixel.util.FlxTimer;
import funkin.Conductor;
import funkin.graphics.FunkinSprite;
import funkin.play.PlayState;
import funkin.play.song.Song;
import funkin.audio.FunkinSound;
import funkin.play.cutscene.CutsceneType;
import funkin.save.Save;
import funkin.modding.PolymodHandler;
import funkin.util.FileUtil;
import funkin.Paths;
#if html5
import funkin.graphics.video.FlxVideo;
#elseif hxvlc
import funkin.graphics.video.FunkinVideoSprite;
#end
import lime.app.Application;
import funkin.play.cutscene.VideoCutscene;
import funkin.play.PlayStatePlaylist;
import funkin.play.GameOverSubState;
import funkin.Preferences;
import funkin.play.ResultState;
import funkin.util.ReflectUtil;

class ObliteratedSongScript extends Song
{
  var hasPlayedInGameCutscene = false;
  var hasPlayedVideo = false;
  var isOnVideo = false;
  var cutsceneSfx:FunkinSound;
  var tweens = [];
  var pausedTweens = [];
  #if html5
  var midVideo:FlxVideo;
  #elseif hxvlc
  var midVideo:FunkinVideoSprite;
  #end
  var blackTween:FlxTween;
  var _currentChange:String;
  var hasDanced:Bool = false;

  public function new()
  {
    super('obliterated');
  }

  public override function listAltInstrumentalIds(difficultyId:String, variationId:String):Array<String>
  {
    if (difficultyId == 'easy' || difficultyId == 'normal' || difficultyId == 'hard')
    {
      var hasBeatenThis = Save.instance.hasBeatenSong(this.id, null);

      switch (variationId)
      {
        default:
          return hasBeatenThis ? ['legacy'] : [];
      }
    }
  }

  override function onBeatHit(event)
  {
    super.onBeatHit(event);
    if (event.beat >= 36
      && event.beat <= 45
      && PlayState.instance.currentStage.getGirlfriend().getCurrentAnimation() == "intro") PlayState.instance.currentStage.getGirlfriend().dance(true);
  }

  override function onSongLoaded(event)
  {
    super.onSongLoaded(event);
    if (PlayState.instance.currentInstrumental == "legacy")
    {
      PlayState.instance.currentVariation = "legacy";
      PlayState.currentChart = PlayState.instance.currentSong.getDifficulty(PlayState.instance.currentDifficulty + "-legacy", "legacy");
      PlayState.instance.vocals = PlayState.instance.currentChart.buildVocals("legacy");
      event.notes = PlayState.instance.currentChart.notes.copy();
      event.events = PlayState.instance.currentChart.getEvents();
    }
  }

  override function onCreate(event:ScriptEvent):Void
  {
    super.onCreate(event);
    setupMidVideo();
    setupFocusHandling();
    _currentChange = PlayState.instance.currentStage.currentChange;
  }

  private function setupMidVideo():Void
  {
    #if html5
    disposeMidVideo();
    #elseif hxvlc
    if (midVideo != null)
    {
      midVideo.stop();
      PlayState.instance.currentStage.remove(midVideo);
      midVideo.destroy();
      midVideo = null;
    }

    midVideo = new FunkinVideoSprite();

    if (midVideo.load(Paths.videos('cutscene')))
    {
      midVideo.bitmap.onEndReached.add(() ->
      {
        midVideo.stop();
        midVideo.visible = false;
      });

      midVideo.bitmap.onFormatSetup.add(() ->
      {
        if (midVideo.bitmap != null && midVideo.bitmap.bitmapData != null)
        {
          midVideo.setGraphicSize(FlxG.initialWidth);
          midVideo.updateHitbox();
          midVideo.screenCenter();
        }
      });

      midVideo.visible = false;
      midVideo.play();
      midVideo.pause();

      PlayState.instance.currentStage.add(midVideo);
    }
    #end
  }

  #if html5
  private function startMidVideo():Void
  {
    disposeMidVideo();

    // FlxVideo plays immediately, so create it only when the mid-song event occurs.
    midVideo = new FlxVideo(Paths.stripLibrary(Paths.videos('cutscene')));
    midVideo.cameras = [PlayState.instance.camHUD];
    // Player and opponent strumlines use zIndex 1001 and 1000 respectively.
    midVideo.zIndex = 999;

    var finishedVideo = midVideo;
    midVideo.finishCallback = () ->
    {
      finishedVideo.visible = false;
      PlayState.instance.remove(finishedVideo);
      if (midVideo == finishedVideo) midVideo = null;
      isOnVideo = false;
    };

    PlayState.instance.add(midVideo);
    PlayState.instance.refresh();
  }

  private function disposeMidVideo():Void
  {
    if (midVideo == null) return;

    PlayState.instance.remove(midVideo);
    midVideo.destroy();
    midVideo = null;
  }
  #end

  override function onPause(event:PauseScriptEvent):Void
  {
    super.onPause(event);

    #if html5
    if (midVideo != null && isOnVideo) midVideo.pauseVideo();
    #elseif hxvlc
    if (midVideo != null && midVideo.bitmap != null && midVideo.bitmap.isPlaying) midVideo.pause();
    #end
  }

  override function onResume(event:ScriptEvent):Void
  {
    super.onResume(event);
    #if html5
    if (midVideo != null && isOnVideo) midVideo.resumeVideo();
    #elseif hxvlc
    if (midVideo != null && isOnVideo) midVideo.resume();
    #end
  }

  override public function onUpdate(event)
  {
    super.onUpdate(event);
    if (isOnVideo)
    {
      PlayState.instance.mayPauseGame = false;
    }
    else
    {
      PlayState.instance.mayPauseGame = true;
    }
  }

  var focusLostCallback:Void->Void;
  var focusGainedCallback:Void->Void;

  private function setupFocusHandling()
  {
    focusLostCallback = function(?_)
    {
      if (midVideo == null || !isOnVideo || !Preferences.autoPause) return;
      #if html5
      midVideo.pauseVideo();
      #elseif hxvlc
      midVideo.pause();
      #end
    }

    focusGainedCallback = function(?_)
    {
      if (midVideo == null || !isOnVideo || !Preferences.autoPause) return;
      #if html5
      midVideo.resumeVideo();
      #elseif hxvlc
      midVideo.resume();
      #end
    }

    Application.current.window.onFocusOut.add(focusLostCallback);
    Application.current.window.onFocusIn.add(focusGainedCallback);
  }

  function onSongRetry(event:ScriptEvent)
  {
    super.onSongRetry(event);
    PlayState.instance.currentStage.getNamedProp("blackScreenR").alpha = 1;

    if (blackTween != null) blackTween.cancel();

    if (midVideo != null)
    {
      #if html5
      disposeMidVideo();
      isOnVideo = false;
      #elseif hxvlc
      midVideo.stop();
      midVideo.visible = false;
      isOnVideo = false;
      #end
    }
  }

  function fetchAssetPaths():Array<String>
  {
    var results:Array<String> = super.fetchAssetPaths();

    results.push(Paths.animateAtlas("saw_mechanic/saw_assets", "shared"));
    results.push(Paths.animateAtlas("saw_mechanic/warning", "shared"));
    results.push(Paths.sound('alert'));
    results.push(Paths.sound('attack'));
    results.push(Paths.image("ui/popup/funkin/dodged"));
    results.push(Paths.videos('cutscene'));

    return results;
  }

  override function onSongStart(event)
  {
    super.onSongStart(event);
    blackTween = FlxTween.tween(PlayState.instance.currentStage.getNamedProp('blackScreenR'), {alpha: 0}, 5, {ease: FlxEase.quadInOut});
  }

  override function onCountdownStart(event:CountdownScriptEvent):Void
  {
    super.onCountdownStart(event);

    showHUD();
    GameOverSubState.musicSuffix = '';
    GameOverSubState.blueBallSuffix = '';
    // PlayState.instance.currentStage.getBoyfriend()?.setSuffix('');
    PlayState.instance.currentStage.getNamedProp("blackScreenR").cameras = [PlayState.instance.camCutscene];
    PlayState.instance.currentStage.getNamedProp("blackScreenR").zIndex = 9999;

    if (blackTween != null) blackTween.cancel();

    PlayState.instance.currentStage.getNamedProp("blackScreenR").alpha = 1;
    PlayState.instance.tweenCameraZoom(1.2, 0, true, FlxEase.quadInOut);
    PlayState.instance.cameraFollowPoint.setPosition(1100, 655);
    PlayState.instance.currentStage.getBoyfriend().playAnimation("intro", true, true);

    if (PlayStatePlaylist.isStoryMode)
    {
      event.cancel();
      event.stopPropagation();
      PlayState.instance.isInCountdown = true;
      PlayState.instance.startSong();
    }
  }

  private function showHUD():Void
  {
    var elements = [
      PlayState.instance.healthBar,
      PlayState.instance.healthBarBG,
      PlayState.instance.scoreText,
      PlayState.instance.opponentStrumline,
      PlayState.instance.iconP2,
      PlayState.instance.iconP1,
      PlayState.instance.playerStrumline
    ];

    for (element in elements)
    {
      element.alpha = 1;
      element.visible = true;
    }
  }

  public function listDifficulties(variationId:String, variationIds:Array<String>, showLocked:Bool):Array<String>
  {
    return (showLocked || Save.instance.hasBeatenLevel('QTWeek')) ? super.listDifficulties(variationId, variationIds) : [];
  }

  override function onNoteGhostMiss(event)
  {
    super.onNoteGhostMiss(event);
    if (isOnVideo)
    {
      event.cancel();
      event.stopPropagation();
    }
  }

  override public function onSongEvent(event:SongEventScriptEvent):Void
  {
    super.onSongEvent(event);

    switch (event.eventData.eventKind)
    {
      case "cutsceneVideo":
        #if html5
        isOnVideo = true;
        startMidVideo();
        FlxTween.tween(PlayState.instance.playerStrumline, {alpha: 0.67}, 2, {ease: FlxEase.quadInOut});
        #elseif hxvlc
        if (midVideo != null)
        {
          isOnVideo = true;
          midVideo.cameras = [PlayState.instance.camHUD];
          midVideo.visible = true;
          midVideo.resume();
          FlxTween.tween(PlayState.instance.playerStrumline, {alpha: 0.67}, 2, {ease: FlxEase.quadInOut});
        }
        #end

      case "cutsceneVideoOut":
        #if html5
        isOnVideo = false;
        disposeMidVideo();
        hudAlpha(1, true);
        PlayState.instance.currentStage.getNamedProp('blackScreenVideo').alpha = 0;
        FlxTween.tween(PlayState.instance.playerStrumline, {alpha: 1}, 1, {ease: FlxEase.quadInOut});
        #elseif hxvlc
        if (midVideo != null)
        {
          isOnVideo = false;
          midVideo.stop();
          midVideo.visible = false;
          hudAlpha(1, true);
          PlayState.instance.currentStage.getNamedProp('blackScreenVideo').alpha = 0;
          FlxTween.tween(PlayState.instance.playerStrumline, {alpha: 1}, 1, {ease: FlxEase.quadInOut});
        }
        #end

      case "fadeStart":
        hudAlpha(0, false);
        FlxTween.tween(PlayState.instance.currentStage.getNamedProp('blackScreenVideo'), {alpha: 1}, 3, {ease: FlxEase.quadInOut});
    }
  }

  private function hudAlpha(alphaInt:Int, instant:Bool)
  {
    var objects = [
      PlayState.instance.healthBar,
      PlayState.instance.healthBarBG,
      PlayState.instance.scoreText,
      PlayState.instance.opponentStrumline,
      PlayState.instance.opponentStrumline.notes,
      PlayState.instance.iconP2,
      PlayState.instance.iconP1
    ];

    for (object in objects)
    {
      if (!instant)
      {
        FlxTween.tween(object, {alpha: alphaInt}, 3, {ease: FlxEase.quadInOut, onComplete: _ -> object.visible = (object.alpha != 0)});
      }
      else
      {
        object.alpha = alphaInt;
        object.visible = (object.alpha != 0);
      }
    }
  }

  function onDestroy(event)
  {
    super.onDestroy(event);

    if (focusLostCallback != null)
    {
      Application.current.window.onFocusOut.remove(focusLostCallback);
      focusLostCallback = null;
    }

    if (focusGainedCallback != null)
    {
      Application.current.window.onFocusIn.remove(focusGainedCallback);
      focusGainedCallback = null;
    }

    if (midVideo != null)
    {
      #if html5
      disposeMidVideo();
      #elseif hxvlc
      midVideo.stop();
      midVideo.destroy();
      midVideo = null;
      #end
    }
  }

  function getStickerPackId(diffId:String, variation:String)
  {
    if (PlayState.instance != null
      && PlayStatePlaylist.isStoryMode
      && PlayState.instance.subState != null
      && ReflectUtil.getClassNameOf(PlayState.instance.subState) == "funkin.play.ResultState")
    {
      return "qtkbStickers";
    }

    return super.getStickerPackId(diffId, variation);
  }
}
